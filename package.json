{
  "name": "inventory-app",
  "version": "1.0.0",
  "description": "Local inventory tracker",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prestart": "node scripts/bootstrap-geolite2.js && node scripts/ensure-yandex-plus-category.js && node scripts/restore-yandex-plus-hq-image.js && node scripts/enable-finance-routes.js && node scripts/bust-assistant-loader-cache.js",
    "start": "node server.js",
    "test": "node tests/navigation-role-access.test.cjs && node tests/mail-host-onboarding.test.cjs && node tests/assistant-engine-v2.test.cjs && node tests/finance-invoice.test.cjs && node tests/account-view-routing.test.cjs && node tests/finance-combo.test.cjs",
    "test:navigation": "node tests/navigation-role-access.test.cjs",
    "test:assistant": "node tests/assistant-engine-v2.test.cjs",
    "test:assistant-analytics": "node tests/assistant-analytics.test.cjs",
    "test:visitor-analytics": "node tests/visitor-analytics.test.cjs",
    "test:backup": "node tests/backup-flow.test.cjs",
    "test:mail": "node tests/mail-service.test.cjs && node tests/mail-host-onboarding.test.cjs",
    "test:api": "node tests/api-integration.test.cjs",
    "test:finance": "node tests/finance-invoice.test.cjs && node tests/finance-combo.test.cjs",
    "test:accounts": "node tests/account-view-routing.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:desktop": "playwright test --project=desktop-chromium"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^1.4.2",
    "jsonwebtoken": "9.0.3",
    "mailparser": "^3.9.12",
    "maxmind": "^5.0.7",
    "mongodb": "7.2.0",
    "sanitize-html": "^2.17.5"
  }
}
